# ─────────────────────────────────────────────────────────────────────────────
# Hana Care Phase 2 — environment variables
# Local: copy to .env.local   ·   Docker: copy to .env   ·   Vercel: Project → Settings → Environment Variables
# NEXT_PUBLIC_* are inlined at BUILD time → redeploy after changing them.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical / OG / sitemap base URL.
# Vercel demo: leave EMPTY → falls back to the Vercel production URL automatically.
# Real launch: set to the real domain, e.g. https://phatracare.phatra-leasing.com
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager container, e.g. GTM-XXXXXXX (empty = GTM disabled)
NEXT_PUBLIC_GTM_ID=

# LINE OA add-friend URL, e.g. https://line.me/R/ti/p/@hanacare
NEXT_PUBLIC_LINE_URL=https://line.me

# On-page GA4 event inspector + toasts (true only for staging/client demo)
NEXT_PUBLIC_GA4_DEBUG=false

# Block search engines (robots.txt disallow + meta noindex).
# Not needed on Vercel — VERCEL=1 already forces noindex for every Vercel deploy.
NOINDEX=false

# ── Docker only (ignored by Vercel) ─────────────────────────────────────────
PORT=3100
DEV_PORT=3101
